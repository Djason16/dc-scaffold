# A folder without index page is never listed (« Index of / »: every file of the site shown to anyone, and to Google)
Options -Indexes

# Enable URL rewriting
RewriteEngine On

# Allow direct access to the uploads directory
RewriteCond %{REQUEST_URI} ^/uploads/
RewriteRule ^ - [L]

# Redirect all other requests to the public directory
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L]
