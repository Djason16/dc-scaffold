# API (inside the site): environment
APP_ENV=development
APP_NAME=

# Database ("localhost" with the port exposed by Docker)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT={{DB_HOST_PORT}}
DB_NAME=
DB_USER=root
DB_PASS=
DB_TIMEZONE=Europe/Paris
# SQLite only (DB_CONNECTION=sqlite): path from frontend/
DB_FILE=database/database.sqlite
