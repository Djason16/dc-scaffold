                {
                    "replace": {
                        "file": "next.config.mjs",
                        "find": "(?m)^ *//[^\\n]*\\n *//[^\\n]*\\n *output: 'export',\\n",
                        "with": "    // Node.js server (npm start): the pages and the API (app/api) together\n"
                    }
                },
                {
                    "replace": {
                        "file": "next.config.mjs",
                        "find": "trailingSlash: true,",
                        "with": "trailingSlash: true,\n    // /api/products and /api/products/ both reach the API, without a redirect\n    skipTrailingSlashRedirect: true,"
                    }
                },
                {
                    "replace": {
                        "file": "next.config.mjs",
                        "find": "(?m)^/\\*\\* @type",
                        "with": "import { SecurityHelper } from './server/SecurityHelper.ts'\n\n/** @type"
                    }
                },
                {
                    "replace": {
                        "file": "next.config.mjs",
                        "find": "images: \\{ unoptimized: true \\},",
                        "with": "images: { unoptimized: true },\n    // Security headers on every page and every answer of the API (server/SecurityHelper.ts)\n    async headers() {\n        return [{ source: '/:path*', headers: Object.entries(SecurityHelper.headers(true)).map(([key, value]) => ({ key, value })) }]\n    },\n    // www.my-site.com -> my-site.com (path kept): not every host does it, the site does it itself\n    async redirects() {\n        return [\n            { source: '/:path*', has: [{ type: 'host', value: 'www[.](?<host>.+)' }], destination: 'https://:host/:path*', permanent: true },\n            { source: '/:path*', has: [{ type: 'header', key: 'x-forwarded-host', value: 'www[.](?<host>.+)' }], destination: 'https://:host/:path*', permanent: true },\n        ]\n    },"
                    }
                },
                {
                    "npm": {
                        "set": {
                            "scripts.start": "next start",
                            "scripts.postbuild": "node scripts/sitemap.mjs .next/server/pages --pages pages --to public"
                        }
                    }
                },
                {
                    "npm": {
                        "set": {
                            "devDependencies.@types/node": "^{{V_TYPES_NODE}}"
                        }
                    },
                    "when": "ts"
                }
            ],
            "guide": {
                "entry": "../app/api/[[...path]]/route.js"
            },
