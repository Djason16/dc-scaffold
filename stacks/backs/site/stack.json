                        }
                    },
                    "when": "noDb"
                },
                {
                    "env": {
                        "file": ".env.example",
                        "values": {
                            "DB_CONNECTION": "sqlite",
                            "DB_HOST": "",
                            "DB_NAME": "",
                            "DB_USER": "",
                            "DB_PASS": "",
                            "DB_PORT": ""
                        }
