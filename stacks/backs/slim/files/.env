# Environment
APP_ENV=development
APP_NAME="{{PROJECT_NAME}}"

# Database ("db" = docker compose service name)
DB_HOST=db
DB_NAME={{DB_NAME}}
DB_USER=root
DB_PASS={{DB_PASS}}
DB_TIMEZONE=Europe/Paris

# Application URLs
APP_BASE_URL=http://localhost:{{APP_PORT}}
API_BASE_URL=http://localhost:{{API_PORT}}
