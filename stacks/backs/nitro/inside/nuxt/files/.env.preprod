# Qualif API (server/): the same lines as .env.production, but its own database (never the production one)
APP_ENV=production
APP_NAME="{{PROJECT_NAME}}"

# Database of the qualif (server credentials)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_TIMEZONE=Europe/Paris
# SQLite only (DB_CONNECTION=sqlite): path from frontend/
DB_FILE=database/database.sqlite
