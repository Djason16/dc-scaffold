# Environment
APP_ENV=development
APP_NAME="{{PROJECT_NAME}}"

# Database (MySQL container, exposed on the host)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT={{DB_HOST_PORT}}
DB_NAME={{DB_NAME}}
DB_USER=root
DB_PASS={{DB_PASS}}
DB_TIMEZONE=Europe/Paris
# SQLite only (DB_CONNECTION=sqlite): path from backend/
DB_FILE=database/database.sqlite

# Application URLs
APP_BASE_URL=http://localhost:{{APP_PORT}}
API_BASE_URL=http://localhost:{{API_PORT}}
