# Qualif (the site shown to the client before it goes online): the same lines as .env.production, but its own database
# (never the production one) and the qualif addresses. start.bat then Q copies it as .env.production into qualif/
APP_ENV=production
APP_NAME="{{PROJECT_NAME}}"

# Database of the qualif (server credentials)
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_TIMEZONE=Europe/Paris

# Qualif addresses: the site and the API each in their folder
# Origin allowed to call the API (CORS): the domain of the site only, never its folder
APP_BASE_URL=https://qualifs.example.com
API_BASE_URL=https://qualifs.example.com/{{SLUG}}-api
