{
    "label": "PHP",
    "order": 40,
    "description": {
        "fr": "PHP sans outil en plus : fonctionne chez tous les hébergeurs",
        "en": "PHP with no extra tool: works with every web host"
    },
    "vscode": ["bmewburn.vscode-intelephense-client"],
    "requires": [
        "docker"
    ],
    "runtime": "php",
    "database": true,
    "steps": [
        {
            "copy": "@shared/php-common"
        },
        {
            "copy": "@shared/php-core",
            "to": "src/Core"
        },
        {
            "copy": "@shared/php-security",
            "to": "src/Helper"
        },
        {
            "copy": "@shared/php-uploads",
            "to": "uploads"
        },
        {
            "copy": "@shared/php-db/{{DB_DRIVER}}"
        },
        {
            "copy": "files"
        },
        {
            "env": {
                "file": ".env",
                "values": {
                    "DB_HOST": "",
                    "DB_NAME": "",
                    "DB_USER": "",
                    "DB_PASS": ""
                }
            },
            "when": "noDb"
        },
        {
            "env": {
                "file": ".env.production",
                "values": {
                    "DB_HOST": "",
                    "DB_NAME": "",
                    "DB_USER": "",
                    "DB_PASS": ""
                }
            },
            "when": "noDb"
        },
        {
            "env": {
                "file": ".env.example",
                "values": {
                    "DB_HOST": "",
                    "DB_NAME": "",
                    "DB_USER": "",
                    "DB_PASS": ""
                }
            },
            "when": "noDb"
        }
    ],
    "drivers": [
        "mysqli",
        "pdo"
    ],
    "controllers": "src/Controllers",
    "controllerExt": "php",
    "guide": {
        "helpers": "src/Helper",
        "middleware": "bootstrap.php",
        "entry": "public/index.php",
        "envDev": ".env",
        "envProd": ".env.production",
        "custom": "#[Route('POST', '/{id}/mark-shipped')]",
        "success": "ResponseHelper::success(['products' => $products])",
        "body": "$this->body()",
        "missing": "RequestHelper::missing($data, ['name', 'price'])",
        "db": "$this->fetchAll('SELECT * FROM products WHERE active = ?', [1])",
        "deploy": "php"
    },
    "online": {
        "fr": "envoie `backend/` (avec `.env.production`, **sans le `.env`**) sur un hébergement PHP {{PHP_VERSION}}+ ; l'adresse de l'API pointe sur le dossier `backend/` envoyé (pas sur `public/` : son `.htaccess` fait le tri) (sans Composer). Rien à régler sur le serveur : sans `.env`, l'API lit `.env.production`",
        "en": "upload `backend/` (with `.env.production`, **without the `.env`**) to a PHP {{PHP_VERSION}}+ host; the address of the API points to the uploaded `backend/` folder (not to `public/`: its `.htaccess` sorts the requests) (no Composer). Nothing to set on the server: without `.env`, the API reads `.env.production`"
    }
}
