{
    "label": "AdonisJS",
    "order": 64,
    "description": {
        "fr": "TypeScript (Node.js), tout est prévu comme dans Laravel",
        "en": "TypeScript (Node.js), everything included like Laravel"
    },
    "requires": [
        "node",
        "docker"
    ],
    "runtime": "node",
    "database": "optional",
    "noDatabase": {
        "fr": "Les données dans un simple fichier, rien à installer",
        "en": "The data in a plain file, nothing to install"
    },
    "fallbackDatabase": "SQLite",
    "nodeEngine": ">=24.0.0",
    "versions": [
        {
            "package": "@adonisjs/core",
            "registry": "npm",
            "stable": "7",
            "token": "V_ADONIS",
            "pin": [
                "dependencies.@adonisjs/core"
            ]
        },
        {
            "package": "create-adonisjs",
            "registry": "npm",
            "stable": "3",
            "token": "V_CREATE_ADONIS"
        }
    ],
    "steps": [
        {
            "run": [
                "npx",
                "--yes",
                "create-adonisjs@^{{V_CREATE_ADONIS}}",
                "{{DIR}}",
                "-K",
                "api",
                "--pkg=npm",
                "--skip-migrations"
            ],
            "in": "root"
        },
        {
            "check": "adonisrc.ts"
        },
        {
            "copy": "@shared/js-core",
            "to": "app/core"
        },
        {
            "remove": [
                "app/core/DatabaseHelper.js"
            ]
        },
        {
            "copy": "files"
        },
        {
            "replace": {
                "file": ".env.example",
                "find": "(?m)^#-+\\r?\\n# CORS.*\\r?\\n#-+\\r?\\n# CORS_ORIGIN=.*\\r?\\n?",
                "with": ""
            }
        },
        {
            "replace": {
                "file": ".env",
                "find": "(?m)^#-+\\r?\\n# CORS.*\\r?\\n#-+\\r?\\n# CORS_ORIGIN=.*\\r?\\n?",
                "with": ""
            }
        },
        {
            "replace": {
                "file": "tsconfig.json",
                "find": "\"outDir\": \"\\./build\"",
                "with": "\"outDir\": \"./build\",\n    \"allowJs\": true"
            }
        },
        {
            "replace": {
                "file": "start/env.ts",
                "find": "\\n\\}\\)\\s*$",
                "with": "\n\n  // DC Scaffold: name of the API, front allowed by CORS (config/cors.ts)\n  APP_NAME: Env.schema.string.optional(),\n  APP_BASE_URL: Env.schema.string.optional(),\n\n  // Database (config/database.ts): sqlite or mysql\n  DB_CONNECTION: Env.schema.enum.optional(['sqlite', 'mysql'] as const),\n  DB_HOST: Env.schema.string.optional({ format: 'host' }),\n  DB_PORT: Env.schema.number.optional(),\n  DB_USER: Env.schema.string.optional(),\n  DB_PASSWORD: Env.schema.string.optional(),\n  DB_DATABASE: Env.schema.string.optional(),\n})\n"
            }
        },
        {
            "npm": {
                "set": {
                    "name": "{{SLUG}}-backend",
                    "imports.#core/*": "./app/core/*.js",
                    "imports.#helpers/*": "./app/helpers/*.js",
                    "dependencies.mysql2": "^3.24.0"
                }
            }
        },
        {
            "env": {
                "file": ".env",
                "values": {
                    "PORT": "{{API_PORT}}",
                    "HOST": "0.0.0.0",
                    "APP_URL": "http://localhost:{{API_PORT}}",
                    "APP_NAME": "\"{{PROJECT_NAME}}\"",
                    "APP_BASE_URL": "http://localhost:{{APP_PORT}}"
                }
            }
        },
        {
            "env": {
                "file": ".env",
                "values": {
                    "DB_CONNECTION": "mysql",
                    "DB_HOST": "localhost",
                    "DB_PORT": "{{DB_HOST_PORT}}",
                    "DB_USER": "root",
                    "DB_PASSWORD": "{{DB_PASS}}",
                    "DB_DATABASE": "{{DB_NAME}}"
                }
            },
            "when": "db"
        },
        {
            "env": {
                "file": ".env",
                "values": {
                    "DB_CONNECTION": "sqlite"
                }
            },
            "when": "noDb"
        },
        {
            "env": {
                "file": ".env.production",
                "from": ".env.example",
                "values": {
                    "NODE_ENV": "production",
                    "PORT": "3333",
                    "HOST": "0.0.0.0",
                    "APP_KEY": "{{NEW_SECRET}}",
                    "APP_URL": "https://api.example.com",
                    "APP_NAME": "\"{{PROJECT_NAME}}\"",
                    "APP_BASE_URL": "https://example.com"
                }
            }
        },
        {
            "env": {
                "file": ".env.production",
                "values": {
                    "DB_CONNECTION": "mysql",
                    "DB_HOST": "localhost",
                    "DB_PORT": "3306",
                    "DB_USER": "",
                    "DB_PASSWORD": "",
                    "DB_DATABASE": ""
                }
            },
            "when": "db"
        },
        {
            "env": {
                "file": ".env.production",
                "values": {
                    "DB_CONNECTION": "sqlite"
                }
            },
            "when": "noDb"
        },
        {
            "env": {
                "file": ".env.example",
                "values": {
                    "PORT": "{{API_PORT}}",
                    "HOST": "0.0.0.0",
                    "APP_NAME": "\"{{PROJECT_NAME}}\"",
                    "APP_BASE_URL": "http://localhost:{{APP_PORT}}",
                    "DB_CONNECTION": "sqlite"
                }
            }
        }
    ],
    "controllers": "app/controllers",
    "controllerExt": "ts",
    "controllerFile": "products_controller.ts",
    "guide": {
        "helpers": "app/helpers",
        "middleware": "start/kernel.ts",
        "entry": "start/routes.ts",
        "envDev": ".env",
        "envProd": ".env.production",
        "custom": "static routes = { markShipped: ['POST', '/{id}/mark-shipped'] }",
        "success": "ResponseHelper.success(response, { products })",
        "body": "this.body(request)",
        "missing": "RequestHelper.missing(data, ['name', 'price'])",
        "db": "await this.fetchAll('SELECT * FROM products WHERE active = ?', [1])",
        "deploy": "adonis"
    },
    "online": {
        "fr": "`start.bat` puis `A` (compilation dans `backend/build`), envoie `backend/build/` sur un hébergement Node.js 24+ avec `.env.production` renommé `.env`, puis `npm ci --omit=dev` et `node bin/server.js`",
        "en": "`start.bat` then `A` (build in `backend/build`), upload `backend/build/` to a Node.js 24+ host with `.env.production` renamed `.env`, then `npm ci --omit=dev` and `node bin/server.js`"
    }
}
