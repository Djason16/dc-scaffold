# Qualif (the site shown to the client before it goes online): the same lines as .env.production, only the addresses
# change. The folder of the site is read in the address (start.bat then Q, or npm run generate:qualif / build:qualif)
NUXT_PUBLIC_SITE_NAME="{{PROJECT_NAME}}"
NUXT_PUBLIC_SITE_URL=https://qualifs.example.com/{{SLUG}}
