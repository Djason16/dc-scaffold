{
    "label": "Astro",
    "order": 60,
    "description": {
        "fr": "Pour les sites de contenu (blog, vitrine) : très rapide",
        "en": "For content sites (blog, showcase): very fast"
    },
    "vscode": [
        "astro-build.astro-vscode"
    ],
    "requires": [
        "node"
    ],
    "port": 4321,
    "versions": [
        {
            "package": "astro",
            "registry": "npm",
            "stable": "7",
            "token": "V_ASTRO"
        },
        {
            "package": "@astrojs/check",
            "registry": "npm",
            "stable": "0",
            "token": "V_ASTRO_CHECK"
        },
        {
            "package": "@types/node",
            "registry": "npm",
            "stable": "26",
            "token": "V_TYPES_NODE"
        }
    ],
    "publicDir": "public",
    "hashedDir": "_astro",
    "api": {
        "file": "src/lib/api.ts",
        "imports": "",
        "base": "import.meta.env.PUBLIC_API_URL",
        "source": "PUBLIC_API_URL",
        "isDev": "import.meta.env.DEV",
        "usage": "import { api } from '../lib/api'"
    },
    "steps": [
        {
            "copy": "@shared/front-core",
            "to": "src"
        },
        {
            "copy": "@shared/front-spa",
            "to": "src"
        },
        {
            "copy": "@shared/front-dom",
            "to": "src"
        },
        {
            "copy": "@shared/front-astro",
            "to": "src"
        },
        {
            "copy": "@shared/dc-scaffold",
            "to": "src/dc-scaffold"
        },
        {
            "copy": "@shared/front-css",
            "to": "src/assets/css"
        },
        {
            "copy": "@shared/front-scripts"
        },
        {
            "copy": "@shared/front-design"
        },
        {
            "copy": "files"
        },
        {
            "copy": "@shared/front-qualif"
        },
        {
            "npm": {
                "set": {
                    "scripts.build:qualif": "node scripts/qualif.mjs"
                }
            }
        },
        {
            "npm": {
                "set": {
                    "scripts.predev": "node scripts/design.mjs",
                    "scripts.prebuild": "node scripts/design.mjs"
                }
            }
        },
        {
            "copy": "files-api",
            "when": "separateApi"
        },
        {
            "npm": {
                "set": {
                    "devDependencies.@astrojs/check": "^{{V_ASTRO_CHECK}}",
                    "devDependencies.typescript": "~6.0.3",
                    "scripts.check": "astro check",
                    "devDependencies.@types/node": "^{{V_TYPES_NODE}}"
                }
            },
            "when": "ts"
        }
    ],
    "layout": {
        "src": "src/",
        "css": "src/assets/css",
        "pages": "src/pages/",
        "storeLib": "`utils/store.ts`",
        "lang": "plugins/lang.ts",
        "storeFile": "stores/userPreferences.ts",
        "layoutFile": "components/layout/AppShell/AppShell.astro",
        "env": "`PUBLIC_SITE_NAME` / `PUBLIC_SITE_URL`",
        "public": "frontend/public",
        "page": "pages/about.astro",
        "pageCopy": "pages/index.astro",
        "textUsage": "`<h1 data-i18n=\"introTitle\">{t('introTitle')}</h1>`",
        "header": "components/layout/Header/Header.astro",
        "footer": "components/layout/Footer/Footer.astro",
        "omitGuide": [
            "LOADER_PAGE_TIME"
        ],
        "designClientTexts": true
    },
    "deploy": {
        "key": "B",
        "dir": "dist"
    }
}
