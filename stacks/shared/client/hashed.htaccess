# Files of the build: their name changes with their content (hash), so the browser keeps them a year without asking again
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css|woff|woff2|ttf|otf|png|jpg|jpeg|gif|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
