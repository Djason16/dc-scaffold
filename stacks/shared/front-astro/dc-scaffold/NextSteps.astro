---
import { lang } from '../plugins/lang.js'

// "What next?" section of DC Scaffold: three cards (texts in dc-scaffold/texts/nextSteps.js)
const t = lang.getTranslation
---

<div class="next-steps">
    <div class="next-steps-header">
        <h2 data-i18n="nextStepsTitle">{t('nextStepsTitle')}</h2>
        <p data-i18n="nextStepsText">{t('nextStepsText')}</p>
    </div>
    <ol class="next-steps-list">
        <li class="next-steps-card">
            <span>01</span>
            <h3 data-i18n="nextStepDesignTitle">{t('nextStepDesignTitle')}</h3>
            <p data-i18n="nextStepDesignText">{t('nextStepDesignText')}</p>
        </li>
        <li class="next-steps-card">
            <span>02</span>
            <h3 data-i18n="nextStepTextsTitle">{t('nextStepTextsTitle')}</h3>
            <p data-i18n="nextStepTextsText">{t('nextStepTextsText')}</p>
        </li>
        <li class="next-steps-card">
            <span>03</span>
            <h3 data-i18n="nextStepPagesTitle">{t('nextStepPagesTitle')}</h3>
            <p data-i18n="nextStepPagesText">{t('nextStepPagesText')}</p>
        </li>
    </ol>
</div>
