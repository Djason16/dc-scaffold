---
import { useSite } from '../../../composables/useSite'
import { lang } from '../../../plugins/lang'
import { buildSeo } from '../../../utils/seo'

// @two-languages
// <head> of a page from SEO_PAGES (utils/seo.ts), written into the HTML at build time (default language)
// @end-two-languages
// @one-language
// <head> of a page from SEO_PAGES (utils/seo.ts), written into the HTML at build time
// @end-one-language
type Props = { pageKey: string }
const { pageKey } = Astro.props
const seo = buildSeo({ pageKey, t: lang.getTranslation, locale: lang.current, site: useSite() })
---

<title>{seo.title}</title>
{seo.meta.map((tag) => 'property' in tag
    ? <meta property={tag.property} content={tag.content} />
    : <meta name={tag.name} content={tag.content} />)}
{seo.link.map((link) => <link rel={link.rel} href={link.href} />)}
{seo.jsonLd && <script type="application/ld+json" set:html={JSON.stringify(seo.jsonLd)} />}
