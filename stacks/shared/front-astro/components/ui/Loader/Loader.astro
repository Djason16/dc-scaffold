---
import { lang } from '../../../plugins/lang'
---

<!-- The loading screen of the site while the page gets ready ("Loading" over a thin line), removed by plugins/app.js -->
<div class="loader" role="status" aria-live="polite" data-loader>
    <p class="loader-label">{lang.getTranslation('loading')}</p>
    <span class="loader-line" aria-hidden="true"></span>
</div>
