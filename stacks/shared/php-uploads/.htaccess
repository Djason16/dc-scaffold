# Files sent by the visitors: shown as files, never run as code (a .php sent as an image does nothing)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(php|phtml|php\d|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
Options -Indexes -ExecCGI

# Sent files keep their name (a new file gets a new name): kept 30 days by the browser
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=2592000"
</IfModule>
