# Enable URL rewriting
RewriteEngine On

# Allow direct access to the uploads directory
RewriteCond %{REQUEST_URI} ^/uploads/
RewriteRule ^ - [L]

# Redirect all other requests to the public directory
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L]

# No APP_ENV here: it comes from .env (development) or .env.production (online), nothing to change on the server
